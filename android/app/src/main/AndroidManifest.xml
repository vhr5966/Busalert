<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Location: required by geolocator for GPS tracking AND by the WiFi
         scan APIs (WifiManager.startScan/getScanResults require
         ACCESS_FINE_LOCATION on every Android version, including 13+).
         Requested at runtime before tracking starts. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- WiFi scanning (wifi_scan package): startScan/getScanResults need
         ACCESS_WIFI_STATE + CHANGE_WIFI_STATE plus the location permission
         above. NEARBY_WIFI_DEVICES is NOT required for these two APIs
         (only for hotspot/P2P/Aware/RTT), per Android docs. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Required for connectivity_plus -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="BusAlert Cardiff"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Google Maps API key (required for google_maps_flutter) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
