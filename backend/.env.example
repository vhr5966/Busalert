# BusAlert Backend Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Render Postgres)
DATABASE_URL=postgres://user:password@host/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busalertdb
DB_USER=busalertdb_user
DB_PASSWORD=kOR7wj675heERYwHXrrXLMO01SzUVNGS

# JWT
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=7d

# Transport Data Provider (SIRI-VM or GTFS-Realtime live buses)
TRANSPORT_PROVIDER_BASE_URL=
TRANSPORT_PROVIDER_API_KEY=
TRANSPORT_FEED_FORMAT=SIRI_VM
TRANSPORT_OPERATOR_IDS=CBUS,FCYM,STWS,SSWL

# BODS Timetables API — for official route/line number data
# Register at https://data.bus-data.dft.gov.uk and copy your API key here.
# Used to query GET /api/v1/dataset/?adminArea=571 (Cardiff) for route lists.
BODS_API_KEY=

# Optional: override BODS with a locally downloaded TransXChange / JSON feed
TRANSPORT_ROUTE_FEED_URL=
