# BusAlert Backend Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busalert
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=7d
